{
  "name": "page-pulse-pro-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "dev:all": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"npm run dev --prefix frontend\" \"npm run dev --prefix backend\"",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm run start",
    "lint": "cd frontend && npm run lint"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0-rc.12",
    "framer-motion": "^11.1.7",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0-alpha.12",
    "@types/node": "^20.12.7",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "concurrently": "^10.0.4",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.0.0-alpha.12",
    "typescript": "^5.4.5"
  }
}
